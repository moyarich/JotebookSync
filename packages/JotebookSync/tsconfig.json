{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node", "mocha"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "out",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true
