{
  "name": "jotebooksync-monorepo",
  "private": true,
  "scripts": {
    "compile": "npm --prefix packages/JotebookSync run compile --",
    "build": "npm --prefix packages/JotebookSync run build --",
    "compile:tests": "npm --prefix packages/JotebookSync run compile:tests --",
    "watch": "npm --prefix packages/JotebookSync run watch --",
    "watch:extension": "npm --prefix packages/JotebookSync run watch:extension --",
    "dev:extension": "npm --prefix packages/JotebookSync run dev:extension --",
    "demo": "npm --prefix packages/JotebookSync run demo --",
    "demo:all": "npm --prefix packages/JotebookSync run demo:all --",
    "demo:freshness": "npm --prefix packages/JotebookSync run demo:freshness --",
    "demo:round-trip": "npm --prefix packages/JotebookSync run demo:round-trip --",
    "demo:formats": "npm --prefix packages/JotebookSync run demo:formats --",
    "demo:gif": "npm --prefix packages/JotebookSync run demo:gif --",
    "lint": "npm --prefix packages/JotebookSync run lint --",
    "test": "npm --prefix packages/JotebookSync run test --",
    "test:webviews": "npm --prefix packages/JotebookSync run test:webviews --",
    "zip": "npm --prefix packages/JotebookSync run zip --",
    "package": "npm --prefix packages/JotebookSync run package --",
    "publish:extension": "npm --prefix packages/JotebookSync run publish:extension --",
    "package:ls": "npm --prefix packages/JotebookSync run package:ls --",
    "build:extension": "npm --prefix packages/JotebookSync run build:extension --",
    "build:webview": "npm --prefix packages/JotebookSync run build:webview --",
    "clean": "npm --prefix packages/JotebookSync run clean --",
    "watch:webview": "npm --prefix packages/JotebookSync run watch:webview --",
    "postinstall": "npm --prefix packages/JotebookSync ci && npm --prefix apps/playground ci && npm --prefix apps/previews ci",
    "dev": "npm run dev:preview",
    "dev:preview": "npm --prefix apps/previews run dev -- --open /",
    "dev:pair-setup": "npm --prefix apps/previews run dev -- --open /pair-setup",
    "dev:freshness": "npm --prefix apps/previews run dev -- --open /freshness-report",
    "dev:convert": "npm --prefix apps/previews run dev -- --open /convert-file",
    "build:playground": "npm --prefix apps/playground run build",
    "typecheck": "npm --prefix packages/JotebookSync run typecheck && npm --prefix apps/previews run typecheck",
    "build:previews": "npm --prefix apps/previews run build",
    "dev:playground": "npm --prefix apps/playground run dev --"
  }
}
