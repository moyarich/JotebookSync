    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sql.js": "^1.15.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "@types/node": "^26.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "vendor/packages/moyaforge",
    "vendor/packages/moyaforge-mdx",
    "vendor/packages/moyaforge-search-sqlite"
