    "@monaco-editor/react": "^4.7.0",
    "@moyarich/console": "^0.1.0",
    "@moyarich/moyaforge": "*",
    "@moyarich/moyaforge-mdx": "*",
    "@moyarich/moyaforge-search-sqlite": "*",
    "@typefox/monaco-editor-react": "^8.0.2",
