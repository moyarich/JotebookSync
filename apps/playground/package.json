    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "shiki": "^4.5.0"
  },
  "scripts": {
    "dev": "npm run build --workspace @moyarich/moyaforge && npm run build --workspace @moyarich/moyaforge-mdx && npm run build --workspace @moyarich/moyaforge-search-sqlite && vite --host 0.0.0.0",
    "build": "npm run build --workspace @moyarich/moyaforge && npm run build --workspace @moyarich/moyaforge-mdx && npm run build --workspace @moyarich/moyaforge-search-sqlite && vite build",
    "preview": "vite preview --host 0.0.0.0",
