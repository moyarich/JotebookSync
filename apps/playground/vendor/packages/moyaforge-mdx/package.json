{
  "name": "@moyarich/moyaforge-mdx",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-independent Markdown and MDX compiler conventions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/moyaforge.git",
    "directory": "packages/moyaforge-mdx"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/plugin.d.ts",
      "import": "./dist/vite/plugin.js"
    },
    "./source-files": {
      "types": "./dist/content/source-files.d.ts",
      "import": "./dist/content/source-files.js"
    },
    "./toc": {
      "types": "./dist/navigation/toc.d.ts",
      "import": "./dist/navigation/toc.js"
    },
    "./navigation": {
      "types": "./dist/navigation/tree.d.ts",
      "import": "./dist/navigation/tree.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "remark-frontmatter": "^5.0.0",
    "remark-flexible-containers": "^1.4.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "unified": "^11.0.5",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "vfile": "^6.0.3",
    "remark-mdx": "^3.1.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "publisher": "moyarich",
  "author": "Moya Richards",
  "keywords": [
    "moyaforge",
    "mdx",
    "markdown",
    "compiler",
    "documentation",
    "vite",
    "content"
  ],
  "homepage": "https://github.com/moyarich/moyaforge/tree/main/packages/moyaforge-mdx#readme",
  "bugs": {
    "url": "https://github.com/moyarich/moyaforge/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
